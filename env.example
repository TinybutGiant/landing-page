# API Configuration
# Local development should usually leave VITE_API_URL unset so requests use
# relative /api paths through the Vite proxy in vite.config.ts.

# Override only when intentionally bypassing the Vite proxy.
# VITE_API_URL=https://ahhh-yaotu.onrender.com

# Canonical main application/auth origin for email verification pages.
# Landing does not consume verification tokens itself.
VITE_AUTH_ORIGIN=https://ahhh-yaotu.onrender.com
