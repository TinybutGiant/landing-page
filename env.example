# Backend API origin used by production/static builds.
# This is public build-time configuration, not a secret.
VITE_API_URL=https://api.ahhh-yaotu.com

# Main Yaotu marketplace/frontend origin for browser navigation.
VITE_MARKETPLACE_ORIGIN=https://www.ahhh-yaotu.com

# Optional override if auth verification pages live somewhere different from
# the marketplace origin. Leave unset for the normal www frontend.
# VITE_AUTH_ORIGIN=https://www.ahhh-yaotu.com

# Local development:
# - Leave VITE_API_URL unset in .env.local to make browser /api requests hit
#   the Vite dev server.
# - Vite then proxies /api to YAOTU_DEV_PROXY_TARGET.
# - If YAOTU_DEV_PROXY_TARGET is unset, vite.config.ts uses http://127.0.0.1:5000.
# YAOTU_DEV_PROXY_TARGET=https://your-dev-api.example.com
